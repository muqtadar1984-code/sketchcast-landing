# HTML pages must revalidate so a deploy is picked up immediately at every edge.
# (Static assets — images, fonts — keep their default long cache.)
/
  Cache-Control: no-cache
/about
  Cache-Control: no-cache
/schools
  Cache-Control: no-cache
/pricing
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/terms
  Cache-Control: no-cache

# i18n:begin — generated by build-i18n.mjs, do not edit by hand
/ms/*
  Cache-Control: no-cache
/ar/*
  Cache-Control: no-cache
/fr/*
  Cache-Control: no-cache
/es/*
  Cache-Control: no-cache
/pt/*
  Cache-Control: no-cache
/te/*
  Cache-Control: no-cache
/mr/*
  Cache-Control: no-cache
/hi/*
  Cache-Control: no-cache
/ms-arab/*
  Cache-Control: no-cache
# i18n:end
