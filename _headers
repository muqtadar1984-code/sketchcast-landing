# HTML pages must revalidate so a deploy is picked up immediately at every edge.
# (Static assets — images, fonts — keep their default long cache.)
/
  Cache-Control: no-cache
/about
  Cache-Control: no-cache
/schools
  Cache-Control: no-cache
/pricing
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/terms
  Cache-Control: no-cache

# Media and images. NOT `immutable`, deliberately: these filenames carry no
# content hash, so an immutable year-long cache would strip a replaced demo cut
# from every browser that had seen the old one. A day of hard cache plus a week
# of serve-stale-while-revalidating gives repeat visitors instant playback and
# still lets a new file propagate within a day.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

